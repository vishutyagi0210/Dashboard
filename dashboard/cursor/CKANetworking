  containers:
    - name: app
      image: busybox
      command: ["sh", "-c", "while true; do echo App log; sleep 5; done"]
    - name: sidecar
      image: busybox
      command: ["sh", "-c", "while true; do echo Sidecar log; sleep 5; done"]


